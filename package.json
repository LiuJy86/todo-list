{
  "name": "todo-list",
  "version": "2.21.1",
  "description": "待办事项清单（Stitch 桌宠版）- Electron 桌面应用",
  "main": "electron/main.js",
  "author": "LiuJy",
  "license": "MIT",
  "homepage": "https://github.com/LiuJy86/todo-list",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.liujy.todolist",
    "productName": "ToDoList",
    "copyright": "Copyright © 2026 LiuJy",
    "electronDist": "node_modules/electron/dist",
    "electronDownload": {
      "mirror": "https://registry.npmmirror.com/-/binary/electron/"
    },
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "待办事项清单"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
